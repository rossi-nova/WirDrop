<Window x:Class="WirDrop.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WirDrop" Height="640" Width="980"
        MinHeight="420" MinWidth="760"
        Background="{StaticResource WindowBackground}"
        AllowDrop="True" Drop="Window_Drop" DragEnter="Window_DragEnter"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedForeground}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedForeground}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部状态栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="WirDrop" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                <Border Background="{StaticResource BadgeBackground}" CornerRadius="10" Padding="10,3"
                        Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="未启动" FontSize="12"
                               Foreground="{StaticResource MutedForeground}"/>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox x:Name="InterfaceCombo" Width="230" Margin="0,0,8,0"
                          DisplayMemberPath="DisplayName" VerticalContentAlignment="Center"/>
                <Button x:Name="ToggleButton" Style="{StaticResource ToolButton}" Content="启动"
                        Click="ToggleButton_Click"/>
                <Button x:Name="ScanButton" Style="{StaticResource ToolButton}" Content="扫描局域网"
                        Click="ScanButton_Click"/>
                <Button x:Name="OpenFolderButton" Style="{StaticResource GhostButton}"
                        Content="打开下载目录" Click="OpenFolder_Click"/>
            </StackPanel>
        </Grid>

        <!-- 主内容 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 设备列表 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}" Text="附近的设备"/>
                    <ListBox Grid.Row="1" x:Name="PeersList" Background="Transparent"
                             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemsSource="{Binding Peers}"
                             MouseDoubleClick="PeersList_MouseDoubleClick"
                             KeyDown="PeersList_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,9" Margin="0,2" Background="{StaticResource BadgeBackground}"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                                Background="{StaticResource Accent}" Margin="0,0,10,0">
                                            <TextBlock Text="📱" FontSize="17" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ServiceId}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Address}" FontSize="11"
                                                       Foreground="{StaticResource MutedForeground}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedForeground}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 日志 -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}" Text="传输记录"/>
                    <ListBox Grid.Row="1" x:Name="LogList" Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding Logs}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"
                                           Foreground="{StaticResource Foreground}" FontSize="12"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部提示 -->
        <Border Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource Card}" Padding="16,12">
            <TextBlock x:Name="HintText" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedForeground}" FontSize="12"
                       Text="把文件拖到窗口里即可发送；或在下方拖入文件后用鼠标双击设备发送。接收端在设备设置为「所有人」时可见。"/>
        </Border>
    </Grid>
</Window>